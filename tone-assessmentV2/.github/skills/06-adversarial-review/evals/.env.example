# Copy this file to .env and fill in one API key.
# promptfoo reads these environment variables automatically.
#
# SECURITY: keep .env out of git and any shared archive.
# .env files are ignored by the root .gitignore; never commit a real key.

ANTHROPIC_API_KEY=your-anthropic-api-key-here
# or
OPENAI_API_KEY=your-openai-api-key-here
